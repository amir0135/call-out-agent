# ------------------------------------------------------------------
# Call-Out Agent — Local Development Environment
# Copy this file to .env and fill in the values.
# ------------------------------------------------------------------

# --- Required: Azure Communication Services ---
# Provision ACS in the Azure portal, then get a phone number.
ACS_ENDPOINT=https://<your-acs-resource>.communication.azure.com
ACS_PHONE_NUMBER=+1XXXXXXXXXX
# Full ACS connection string. Required when the orchestrator runs in a container
# without a managed identity (e.g. local docker compose). In production on
# Container Apps the managed identity is used and this can be left blank.
# Fetch with: az communication list-key -n <acs-name> -g <rg> --query primaryConnectionString -o tsv
ACS_CONNECTION_STRING=

# --- Required: Cognitive Services (Speech) ---
# Endpoint of the Speech / Cognitive Services resource linked to ACS.
# Required at call-create time; if missing, ACS rejects TTS/STT with error 8522
# and the callee hears silence.
COGNITIVE_SERVICES_ENDPOINT=https://<your-speech-resource>.cognitiveservices.azure.com/

# --- Required: Callback URL (public) ---
# ACS must reach your orchestrator for webhooks.
# In Azure this is the Container App FQDN. Locally, expose port 8000 with:
#   devtunnel host --port-numbers 8000 --allow-anonymous
# Or ngrok: ngrok http 8000
CALLBACK_BASE_URL=https://<your-tunnel-url>

# --- Agent mode ---
# true = rule-based local agent (no Azure OpenAI needed)
# false = requires Azure OpenAI endpoint below
LOCAL_MODE=true

# --- Optional: Azure OpenAI (only if LOCAL_MODE=false) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Optional: Cosmos DB (skip = audit logs go to stdout) ---
COSMOS_ENDPOINT=

# --- Optional: Speech settings ---
SPEECH_REGION=eastus
SPEECH_VOICE=en-US-JennyNeural

# --- Agent endpoint (auto-set by docker-compose) ---
FOUNDRY_AGENT_ENDPOINT=http://agent:8080

# --- Agentic RAG: Knowledge Bases (Foundry IQ) ---
# Enable/disable knowledge retrieval (true by default)
RAG_ENABLED=true

# Azure AI Search endpoint for knowledge indexes
AZURE_AI_SEARCH_ENDPOINT=

# Index names per knowledge domain (defaults shown)
INDEX_EQUIPMENT=idx-equipment-manuals
INDEX_MAINTENANCE=idx-maintenance-guides
INDEX_STORE_PROFILES=idx-store-profiles
INDEX_ALARM_HISTORY=idx-alarm-history
